# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Never commit real secrets.

# Async driver (+asyncpg) is required. Host is "localhost" when running the API
# on your machine; docker-compose overrides it to the "postgres" service.
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5433/documind
REDIS_URL=redis://localhost:6379/0

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

ANTHROPIC_API_KEY=
EMBEDDING_API_KEY=

# Uploaded files are stored here (docker-compose mounts a volume at /data/storage).
STORAGE_PATH=./storage
MAX_UPLOAD_MB=20
