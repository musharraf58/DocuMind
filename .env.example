# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Never commit real secrets.

# Async driver (+asyncpg) is required. Host is "localhost" when running the API
# on your machine; docker-compose overrides it to the "postgres" service.
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5433/documind
REDIS_URL=redis://localhost:6379/0

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

ANTHROPIC_API_KEY=

# Uploaded files are stored here (docker-compose mounts a volume at /data/storage).
STORAGE_PATH=./storage
MAX_UPLOAD_MB=20

# Chunking: target chunk size and overlap between consecutive chunks, in tokens.
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

# Extraction limits. A document over any limit is marked "failed".
MAX_EXTRACT_PAGES=500
MAX_EXTRACTED_CHARS=2000000
# Below this many characters of text the document fails (likely a scanned PDF).
MIN_EXTRACTED_CHARS=50
# Zip-bomb guard for .docx files.
MAX_DOCX_UNCOMPRESSED_MB=100
MAX_DOCX_ENTRIES=1000

# Embeddings. "fake" needs no API key and makes no network calls (local dev, tests);
# "voyage" calls Voyage AI and needs EMBEDDING_API_KEY.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=voyage-4-lite
# Changing this requires a new migration for the chunks.embedding column.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30

# Your embedding account's real limits per minute. We plan to use only
# EMBEDDING_RATE_SAFETY (a fraction) of the token limit, since our token count can be
# well below the provider's. With the defaults: 5000 tokens and 3 requests per minute,
# shared by the API and the worker (see EMBEDDING_INGEST_RPM_SHARE below). The worker's
# log shows estimated vs. actual tokens
# per batch, to help you tune this.
EMBEDDING_TPM_LIMIT=10000
EMBEDDING_RPM_LIMIT=3
EMBEDDING_RATE_SAFETY=0.5

# Retries per batch. Waits grow exponentially from BASE up to MAX seconds (with
# jitter); a Retry-After header from the provider is honoured instead when present.
EMBEDDING_MAX_RETRIES=6
EMBEDDING_RETRY_BASE_SECONDS=2
EMBEDDING_RETRY_MAX_SECONDS=60
# Shortest wait after a 429. Leave empty for 60 / EMBEDDING_RPM_LIMIT (20 s at 3 per minute).
EMBEDDING_MIN_RETRY_WAIT_SECONDS=
# A search query waits at most this long for capacity, then gets a "busy" response.
EMBEDDING_QUERY_MAX_WAIT_SECONDS=20
# Share of requests per minute background ingestion may use; the rest stays free
# for searches (0.67 x 3 = 2 of 3 requests).
EMBEDDING_INGEST_RPM_SHARE=0.67

# Background jobs (the worker service).
# Tries per document for transient failures; permanent ones fail at once.
MAX_JOB_ATTEMPTS=4
# Wait before retrying a transient failure: 30 s, then 60 s, then 120 s ...
JOB_RETRY_BASE_SECONDS=30
# Longest one job may run (large documents take ~1-2 hours at 10,000 tokens/minute).
JOB_TIMEOUT_MINUTES=120
# Sweeper: re-enqueue documents pending longer than this, and treat processing
# documents with no heartbeat for STALE_PROCESSING_MINUTES as stuck.
SWEEP_PENDING_MINUTES=3
STALE_PROCESSING_MINUTES=10
