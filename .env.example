# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Never commit real secrets.

# Any Postgres URL: postgresql+asyncpg://... or a host's libpq-style
# postgresql://...?sslmode=require (translated for asyncpg). Host is "localhost"
# when running the API on your machine; docker-compose overrides it to "postgres".
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5433/documind
# Migrations only: a direct (non-pooled) URL. Empty: DATABASE_URL.
DATABASE_URL_DIRECT=
# true when DATABASE_URL goes through PgBouncer in transaction mode (Neon "-pooler").
DB_PGBOUNCER=false
REDIS_URL=redis://localhost:6379/0

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

ANTHROPIC_API_KEY=

# Where uploaded files live: local (STORAGE_PATH; docker-compose mounts a volume at
# /data/storage) or s3 (an S3-compatible bucket: R2, B2, MinIO, AWS).
STORAGE_BACKEND=local
STORAGE_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20

# Chunking: target chunk size and overlap between consecutive chunks, in tokens.
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

# Extraction limits. A document over any limit is marked "failed".
MAX_EXTRACT_PAGES=500
MAX_EXTRACTED_CHARS=2000000
# Below this many characters of text the document fails (likely a scanned PDF).
MIN_EXTRACTED_CHARS=50
# Zip-bomb guard for .docx files.
MAX_DOCX_UNCOMPRESSED_MB=100
MAX_DOCX_ENTRIES=1000

# Embeddings. "fake" needs no API key and makes no network calls (local dev, tests);
# "voyage" calls Voyage AI and needs EMBEDDING_API_KEY.
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=voyage-4-lite
# Changing this requires a new migration for the chunks.embedding column.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30

# Your embedding account's real limits per minute. We plan to use only
# EMBEDDING_RATE_SAFETY (a fraction) of the token limit, since our token count can be
# well below the provider's. With the defaults: 5000 tokens and 3 requests per minute,
# shared by the API and the worker (see EMBEDDING_INGEST_RPM_SHARE below). The worker's
# log shows estimated vs. actual tokens
# per batch, to help you tune this.
EMBEDDING_TPM_LIMIT=10000
EMBEDDING_RPM_LIMIT=3
EMBEDDING_RATE_SAFETY=0.5

# Retries per batch. Waits grow exponentially from BASE up to MAX seconds (with
# jitter); a Retry-After header from the provider is honoured instead when present.
EMBEDDING_MAX_RETRIES=6
EMBEDDING_RETRY_BASE_SECONDS=2
EMBEDDING_RETRY_MAX_SECONDS=60
# Shortest wait after a 429. Leave empty for 60 / EMBEDDING_RPM_LIMIT (20 s at 3 per minute).
EMBEDDING_MIN_RETRY_WAIT_SECONDS=
# A search query waits at most this long for capacity, then gets a "busy" response.
EMBEDDING_QUERY_MAX_WAIT_SECONDS=20
# Share of requests per minute background ingestion may use; the rest stays free
# for searches (0.67 x 3 = 2 of 3 requests).
EMBEDDING_INGEST_RPM_SHARE=0.67

# Answer generation. "fake" needs no API key and makes no network calls (local dev,
# tests); "gemini" calls the Google Gemini API and needs LLM_API_KEY.
# Note: on Gemini's FREE tier, Google may use what you send (including excerpts of
# your documents) to improve its products; the paid tier does not.
LLM_PROVIDER=fake
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
# Includes the model's "thinking" tokens.
LLM_MAX_OUTPUT_TOKENS=600
LLM_TIMEOUT_SECONDS=30
# Requests per minute. Check your project's real limits in Google AI Studio.
LLM_RPM_LIMIT=10
# Google recommends keeping 1.0 for Gemini 3 models.
LLM_TEMPERATURE=1.0

# Answering questions: how many chunks to retrieve, the relevance cut-off (cosine
# distance; measured for voyage-4-lite, see docs/EVALUATION.md), how much source text
# goes into the prompt (approximate tokens), and the longest question accepted.
RAG_TOP_K=8
RAG_MAX_DISTANCE=0.70
RAG_CONTEXT_TOKEN_BUDGET=3000
ASK_MAX_QUESTION_CHARS=1000

# Search mode for /search and /ask: "vector" (meaning) or "hybrid" (meaning + keywords,
# merged with Reciprocal Rank Fusion). See docs/EVALUATION.md for how it was chosen.
RAG_SEARCH_MODE=hybrid
HYBRID_CANDIDATES=20
RRF_K=60
# Keyword matching: "strict" (all terms) or "loose" (any term).
RAG_KEYWORD_MATCH=strict
# Postgres text search config; the index is built with 'english'.
TEXT_SEARCH_CONFIG=english
# Hybrid relevance gate: strong keyword matches pass up to RAG_MAX_DISTANCE + this (0 = off).
RAG_KEYWORD_GATE_SLACK=0.10

# Conversations: earlier turns included in the prompt (newest first, within a token
# budget). A follow-up question is rewritten into a standalone question by one short
# LLM call (so a follow-up costs two Gemini requests); after the timeout the original
# question is used.
RAG_HISTORY_MAX_TURNS=6
RAG_HISTORY_TOKEN_BUDGET=1000
RAG_REWRITE_TIMEOUT_SECONDS=10
# Streaming answers: an SSE comment is sent this often while waiting.
STREAM_HEARTBEAT_SECONDS=15

# Where document jobs run: celery (the compose "worker" service) or inline (inside
# the API process, for hosts with no background worker; see "Running in lite mode").
INGESTION_MODE=celery
# Inline mode: queue capacity (uploads beyond it get 503), shutdown grace for the
# running job, and how often the sweeper and retention run in-process.
INLINE_QUEUE_CAPACITY=20
INLINE_SHUTDOWN_GRACE_SECONDS=15
MAINTENANCE_INTERVAL_SECONDS=120

# Background jobs (both modes).
# Tries per document for transient failures; permanent ones fail at once.
MAX_JOB_ATTEMPTS=4
# Wait before retrying a transient failure: 30 s, then 60 s, then 120 s ...
JOB_RETRY_BASE_SECONDS=30
# Longest one job may run (large documents take ~1-2 hours at 10,000 tokens/minute).
JOB_TIMEOUT_MINUTES=120
# Sweeper: re-enqueue documents pending longer than this, and treat processing
# documents with no heartbeat for STALE_PROCESSING_MINUTES as stuck.
SWEEP_PENDING_MINUTES=3
STALE_PROCESSING_MINUTES=10

# --- Security and limits (Phase 9). Why each exists: docs/SECURITY.md. ---

# "production" turns on strict startup checks (weak SECRET_KEY, docs, fake providers...)
# and HSTS. Leave "development" locally.
APP_ENV=development
# Who may create an account: open | invite | closed. In invite mode, INVITE_CODE is
# required (12+ characters in production); empty means nobody can register.
# For local use, REGISTRATION_MODE=open is simplest.
REGISTRATION_MODE=invite
INVITE_CODE=

# Inbound rate limits: N/second | N/minute | N/hour | N/day.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_IP=10/minute
RATE_LIMIT_LOGIN_PER_EMAIL=5/minute
RATE_LIMIT_REGISTER_PER_IP=5/hour
RATE_LIMIT_ACCOUNT=5/minute
RATE_LIMIT_ASK=10/minute
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_DEFAULT=120/minute
# Reverse proxies WE run in front of the API (0: trust no X-Forwarded-For at all).
TRUSTED_PROXY_COUNT=0

# Failed logins (per account + IP): this many are free, then the next try waits
# BASE, 2xBASE, 4xBASE ... seconds, up to MAX. Forgotten after WINDOW minutes.
LOGIN_FREE_ATTEMPTS=3
LOGIN_DELAY_BASE_SECONDS=2
LOGIN_DELAY_MAX_SECONDS=900
LOGIN_FAILURE_WINDOW_MINUTES=15

# Daily quotas. The day starts at this hour (UTC).
QUOTA_RESET_HOUR_UTC=0
DAILY_QUESTIONS_PER_USER=50
DAILY_EMBED_TOKENS_PER_USER=200000
DAILY_UPLOADS_PER_USER=20
# LLM requests per day for ALL users together (answers, rewrites and retries).
GLOBAL_DAILY_LLM_BUDGET=350

# Upload caps per user.
MAX_STORAGE_MB_PER_USER=100
MAX_DOCUMENTS_PER_USER=50
MAX_PENDING_DOCUMENTS_PER_USER=5

# HTTP: allowed browser origins (comma-separated; never *), body limit for non-upload
# requests, and the interactive docs (production also needs ALLOW_DOCS_IN_PRODUCTION=true).
CORS_ORIGINS=
MAX_REQUEST_BODY_KB=64
DOCS_ENABLED=true
ALLOW_DOCS_IN_PRODUCTION=false

# Logs: text | json (one JSON object per line, for log collectors).
LOG_FORMAT=text

# Database pool (API) and statement timeouts. See docs/HARDENING.md.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_WORKER_STATEMENT_TIMEOUT_MS=300000

# Capacity guard: refuse uploads once the database is this big (MB; 0 = off).
MAX_DB_SIZE_MB=400
# Delete ordinary (non-demo) accounts older than this many days (0 = never).
RETENTION_DAYS=0

# The shared read-only demo account: only for `python -m scripts.seed_demo`.
DEMO_EMAIL=
DEMO_PASSWORD=
# The demo page at /demo (/ redirects there when on), and one line shown under
# its login form to every visitor. See docs/OPERATIONS.md.
DEMO_UI_ENABLED=false
DEMO_UI_HINT=
