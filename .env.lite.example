# DocuMind "lite mode": everything on free tiers, one small web instance.
#   Render (web service) + Neon (Postgres) + Upstash (Redis) + R2 or B2 (files)
# See "Running in lite mode" in the README. On Render these are set in the
# dashboard (render.yaml declares them); locally: cp .env.lite.example .env.lite
# and run with --env-file .env.lite. Never commit real values.

# --- Mode -----------------------------------------------------------------------
APP_ENV=production
INGESTION_MODE=inline
STORAGE_BACKEND=s3
REGISTRATION_MODE=invite
DOCS_ENABLED=false
LOG_FORMAT=json
# Proxies in front of the app that append to X-Forwarded-For (Render: 1).
TRUSTED_PROXY_COUNT=1

# --- Secrets --------------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# At least 12 characters; share only with people you invite.
INVITE_CODE=
# Your frontend's origin(s), comma-separated, if a browser app calls the API.
CORS_ORIGINS=

# --- Neon Postgres --------------------------------------------------------------
# Paste Neon's connection strings as they are (postgresql://...?sslmode=require);
# they are translated for asyncpg. Pooled ("-pooler" in the host) for the app,
# direct for migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=
DB_PGBOUNCER=true
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE_SECONDS=240
# Uploads stop at this database size (Neon free plan: 1 GB per project, Oct 2026).
MAX_DB_SIZE_MB=400

# --- Upstash Redis --------------------------------------------------------------
# rediss://default:<password>@<host>.upstash.io:6379  (rediss = TLS)
REDIS_URL=
# Free tier: 500,000 commands/month (~16,400/day). There is no setting for it;
# see docs/HARDENING.md, "Redis command budget", for what each request costs.

# --- S3-compatible bucket -------------------------------------------------------
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com, region "auto"
# Backblaze B2:  https://s3.<region>.backblazeb2.com, region e.g. "us-west-004"
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Providers ------------------------------------------------------------------
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
LLM_PROVIDER=gemini
LLM_API_KEY=

# --- Inline mode, limits --------------------------------------------------------
INLINE_QUEUE_CAPACITY=20
MAINTENANCE_INTERVAL_SECONDS=120
# Delete ordinary accounts older than this many days (0 = never).
RETENTION_DAYS=0

# --- Demo account (only for: python -m scripts.seed_demo) -------------------------
DEMO_EMAIL=
DEMO_PASSWORD=
